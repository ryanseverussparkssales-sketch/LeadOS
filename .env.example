# RogueOS / LeadOS — environment variables
# Copy to .env.local (gitignored) and fill in. Names below match what the code
# actually reads ($env/static|dynamic). Set the same values in Vercel for prod.

# --- Supabase ---------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # server-only; bypasses RLS — keep secret

# --- Anthropic / Groq (AI) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...                          # optional: voicemail/recording transcription

# --- Twilio (voice + SMS) ---------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token             # used for webhook signature validation + REST
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_CLIENT_IDENTITY=agent                  # browser-client identity for inbound routing
# Browser calling (Voice SDK)
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret-here
# Webhook security / behavior (added in security hardening)
TWILIO_WEBHOOK_BASE_URL=https://lead-os-livid.vercel.app   # exact public base; avoids proxy URL-mismatch in signature checks
# TWILIO_SKIP_SIGNATURE_CHECK=true            # rollout escape hatch only — leave UNSET to enforce
# TWILIO_AMD_ENABLED=true                     # enable answering-machine detection + voicemail-drop (smoke-test first)

# --- Stripe Connect (rep payouts) -------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...               # from Stripe webhook endpoint; flips connect status -> active

# --- Email (Resend + inbound) -----------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM=you@yourdomain.com
RESEND_INBOUND_DOMAIN=reply.yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_...               # verify inbound email webhook (svix)

# --- Google (Maps + Gmail OAuth) --------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-key      # RogueScraper geo (Places) mode
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# --- Spotify (dashboard widget, optional) -----------------------------------
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...

# --- Misc -------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...   # optional: wins feed
CRON_SECRET=long-random-string                # gates /api/cron/* + gmail sync
VAULT_ENCRYPTION_KEY=32-byte-key              # encrypts stored API keys / passwords

# --- Public site URLs (must be set at build time on Vercel) -----------------
PUBLIC_SITE_URL=https://lead-os-livid.vercel.app
PUBLIC_APP_URL=https://lead-os-livid.vercel.app
PUBLIC_BASE_URL=https://lead-os-livid.vercel.app
PUBLIC_REPLY_DOMAIN=reply.yourdomain.com

# --- ConversationRelay AI voice agent (relay-server/ runs separately) -------
RELAY_WS_URL=wss://rogue-relay.up.railway.app   # deployed WebSocket server (wss://)
RELAY_SHARED_SECRET=long-random-string          # MUST match the relay server's value
# RELAY_WELCOME_GREETING=Hi, this is Rogue's assistant — do you have a quick minute?
# RELAY_TTS_VOICE=                               # optional TTS voice (e.g. ElevenLabs)
# RELAY_TTS_PROVIDER=                            # optional TTS provider override
# RELAY_STT_PROVIDER=                            # optional transcription provider override
# RELAY_HANDOFF_NUMBER=+1xxxxxxxxxx              # transfer-to-human number on handoff
# RELAY_MODEL=claude-haiku-4-5-20251001          # (relay-server only)

# --- AI practice calls (reps rehearse against an AI buyer; price-gated) ------
PRACTICE_CALLS_ENABLED=false                     # master on/off toggle for the feature
# RELAY_PRACTICE_GREETING=Hello?                  # first words the AI buyer says when the rep answers

# Semantic search (Voyage AI embeddings) � https://www.voyageai.com
VOYAGE_API_KEY=
